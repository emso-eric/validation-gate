# ---------------------------------------------------------------------------
# PostgreSQL for the validation gate. Copy to database/.env and fill in.
#
#     cp database/.env.template database/.env
#
# These values must match the repository-root .env, which is what compose
# interpolates into the gate's GATE_DATABASE_URL and into Grafana's datasource.
# Keeping both files means the postgres image gets exactly the variables it
# expects and nothing else.
# ---------------------------------------------------------------------------

# Generate a password with:  openssl rand -base64 24
# It is only ever used inside the compose network, but it is a real credential:
# GATE_DB_PORT in the root .env can publish this database to the host.
POSTGRES_USER=gate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=emso_gate

# Byte-for-byte reproducible ordering, so a dump taken on one host restores
# identically on another. Changing this after initdb has run has no effect:
# the collation is fixed when the cluster is created, so you would have to
# delete database/pgdata and re-initialise to change it.
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
