# ---------------------------------------------------------------------------
# PostgreSQL, service-specific settings. Copy to database/.env.
#
#     cp database/.env.template database/.env
#
# The credentials, host and port are NOT here: they are deployment
# configuration and live in the repository-root .env, which compose layers
# underneath this file. This one holds only what never changes between
# deployments.
# ---------------------------------------------------------------------------

# Byte-for-byte reproducible ordering, so a dump taken on one host restores
# identically on another. Changing this after initdb has run has no effect:
# the collation is fixed when the cluster is created, so changing it means
# deleting database/pgdata and re-initialising.
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
