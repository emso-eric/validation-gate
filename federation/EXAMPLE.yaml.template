service:
  url: "https://data.obsea.es"  # /erddap is appended when missing

  datasets:
    OBSEA_seabed_station_TS_L1b:  # bare entry: tabledap, URL derived from service URL
    OBSEA_seabed_station_TS_L1c:
      # Override the source URL (rarely needed; only when the dataset is not
      # at <service_url>/<type>/<datasetID>).
      url: "https://different.url/erddap/tabledap/OBSEA_seabed_station_TS_L1c"

      # type: tabledap (default) | griddap
      type: "tabledap"

      # defaultQuery: becomes <defaultGraphQuery> in datasets.xml.
      #
      # Percent-encode the ERDDAP query itself (%2C for a comma, %3A for a
      # colon), but write & < > literally: the gate escapes the XML
      # metacharacters when it generates datasets.xml, so an &amp; here would
      # be written out as &amp;amp; and the graph would not load.
      defaultQuery: "time%2CTEMP%2CTIME_QC&time>2015-04-15T00%3A00%3A00Z&time<2015-04-22T00%3A00%3A00Z&DEPH=1500.0&.draw=linesAndMarkers&.marker=6|3&.color=0x000000&.colorBar=|||||&.bgColor=0xffccccff"









