# ---------------------------------------------------------------------------
# Docker Compose interpolation. Copy to .env and fill in.
#
#     cp .env.example .env
#
# .env is gitignored. The per-service env_files (database/.env, erddap/.env,
# grafana/.env) are too, and each has its own .example next to it.
# ---------------------------------------------------------------------------

# Must match database/.env - compose interpolates these into the gate's
# GATE_DATABASE_URL and into Grafana's datasource.
POSTGRES_USER=gate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emso_gate

# Published ports. The database is bound to loopback by default; widen it only
# if Grafana or psql run outside this compose project.
ERDDAP_PORT=8080
GRAFANA_PORT=3000
GATE_DB_PORT=127.0.0.1:5432
