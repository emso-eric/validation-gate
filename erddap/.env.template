# ---------------------------------------------------------------------------
# Central ERDDAP configuration. Copy to erddap/.env and fill in.
#
#     cp erddap/.env.template erddap/.env
#
# erddap/.env is gitignored; this template is committed. The values below are
# safe defaults and placeholders - no secret belongs in this file.
#
# This replaces a hand-maintained setup.xml. ERDDAP 2.x reads any setup.xml
# setting from an environment variable named ERDDAP_<tagName>, and the image's
# bin/setenv.sh prints every ERDDAP_* it saw at startup — so
#
#     docker compose logs erddap | grep "ERDDAP configured with" -A 60
#
# tells you exactly what took effect, which a setup.xml baked into an image
# never does.
#
# Defaults shown are the ERDDAP v2.x setup.xml defaults unless noted otherwise.
#
# datasets.xml is NOT configured here: it is generated by the gate from the
# federation registry. See gate/README.md.
# ---------------------------------------------------------------------------

# --- identity --------------------------------------------------------------
# The public base URL, without a trailing slash. ERDDAP writes this into every
# link, every .iso19115 record and every DAP response, so getting it wrong is
# visible to harvesters long after it is fixed here.
ERDDAP_baseUrl=http://localhost:8080
ERDDAP_baseHttpsUrl=https://localhost:8443

# Short title shown in the browser title bar and at the top of every page.
# No default — leave blank and ERDDAP will label itself "ERDDAP".
ERDDAP_title=EMSO ERIC ERDDAP

# The institution that runs this ERDDAP. Appears in dataset metadata and on
# the home page. No default.
ERDDAP_institution=EMSO ERIC

# URL for more information about this ERDDAP (shown as a link on the home
# page). No default.
ERDDAP_infoUrl=https://emso.eu

# --- the administrator harvesters and users will contact -------------------
ERDDAP_adminInstitution=EMSO ERIC
ERDDAP_adminInstitutionUrl=https://emso.eu
ERDDAP_adminIndividualName=EMSO ERIC Data Management
ERDDAP_adminPosition=Data Manager
ERDDAP_adminPhone=+00 000 000 000
ERDDAP_adminAddress=Address
ERDDAP_adminCity=City
ERDDAP_adminStateOrProvince=
ERDDAP_adminPostalCode=00000
ERDDAP_adminCountry=Country
ERDDAP_adminEmail=data@emso.eu

# --- where ERDDAP mails its failures ---------------------------------------
# A malformed datasets.xml, a dataset that will not load and an unreachable
# regional server are all reported here and nowhere else. The gate catches the
# first two before deployment, but this is the backstop.
ERDDAP_emailEverythingTo=data@emso.eu
ERDDAP_emailDailyReportTo=data@emso.eu
ERDDAP_emailFromAddress=erddap@emso.eu
ERDDAP_emailSmtpHost=
ERDDAP_emailSmtpPort=25
ERDDAP_emailUserName=
ERDDAP_emailPassword=
# Extra SMTP properties as "key=value|key=value" pairs. Example to enable
# STARTTLS: "mail.smtp.starttls.enable=true|mail.smtp.auth=true"
ERDDAP_emailProperties=

# --- branding --------------------------------------------------------------
# logo.png and favicon.ico are bind-mounted read-only by docker-compose.yaml.
# Background colour for all images (hex ARGB, default 0xFFFFFFFF = white).
ERDDAP_stringBackgroundColor=0xFFFFFF

# HTML fragment injected at the start of <body> on every page. Useful for
# a site-wide banner, navigation bar or CSS link. Leave blank for no addition.
ERDDAP_startBodyHtml5=

# HTML fragment injected at the very end of <body>. Useful for analytics
# scripts or a footer. Leave blank for no addition.
ERDDAP_endBodyHtml5=

# HTML fragment injected inside <head> on every page. Useful for custom
# CSS or a favicon link. Leave blank for no addition.
ERDDAP_startHeadHtml5=

# --- data policy -----------------------------------------------------------
# The access constraints string included in WCS/WMS GetCapabilities responses
# and CSW records. "NONE" means openly accessible. Default: "NONE".
ERDDAP_accessConstraints=NONE

# The standard license text shown in the "Legal Notices" page and included in
# dataset metadata. The default is the standard ERDDAP generic license.
# Override to set a federation-wide policy such as CC BY 4.0:
# ERDDAP_standardLicense=This data is licensed under CC BY 4.0 ...
ERDDAP_standardLicense=

# --- federation behaviour --------------------------------------------------
# How often ERDDAP re-reads datasets.xml. The gate's hardFlag reload method
# makes this mostly irrelevant — a flagged dataset reloads within seconds —
# but it is the floor for anything the gate did not flag.
# Defaults: 15 / 60 minutes.
ERDDAP_loadDatasetsMinMinutes=15
ERDDAP_loadDatasetsMaxMinutes=60

# Every dataset in this federation is an EDD*FromErddap proxy, so the central
# node holds no data and these limits govern pass-through requests only.
# Defaults: 1 / 1 thread.
ERDDAP_nGridThreads=2
ERDDAP_nTableThreads=2

# How long ERDDAP caches user-request results on disk (in minutes).
# A longer value reduces load on the regional servers at the cost of serving
# slightly stale data for repeat queries. Default: 60.
ERDDAP_cacheMinutes=60

# Disk space (GB) available for the decompressed-file cache (intermediate .nc
# files that ERDDAP generates while handling requests). Default: 10.
ERDDAP_decompressedCacheMaxGB=10

# Maximum age (minutes) of files in the decompressed cache. Default: 15.
ERDDAP_decompressedCacheMaxMinutesOld=15

# Number of requests from one IP within 10 minutes that triggers an
# "unusual activity" email to the admin. Default: 400.
ERDDAP_unusualActivity=400

# --- subscriptions ---------------------------------------------------------
# Whether users may subscribe to dataset-change notifications by email.
# Default: true. Requires working email settings above.
ERDDAP_subscriptionSystemActive=true

# --- CORS ------------------------------------------------------------------
# Add CORS headers (Access-Control-Allow-Origin: *) to all responses.
# Enable for public data portals accessed by JavaScript clients. Default: false.
ERDDAP_corsEnabled=false

# --- authentication --------------------------------------------------------
# How users authenticate. Empty = no login required (public federation).
# There is no "none" value: ERDDAP rejects anything outside
# (empty) | custom | email | google | orcid | oauth2 and refuses to start.
# Default: empty.
ERDDAP_authentication=

# --- display ---------------------------------------------------------------
# Default land-mask rendering for map images.
# Values: under | over | outline | off. Default: under.
ERDDAP_drawLandMask=under

# Use higher-resolution (2x) coastline/border images in map responses.
# Increases memory use slightly. Default: false.
ERDDAP_highResolutionImages=false

# --- security --------------------------------------------------------------
# Generated randomly by the image on first start if left empty, but then it
# changes on every recreate and every previously issued flag URL stops
# working. Set it once, keep it out of git.
ERDDAP_flagKeyKey=

# --- JVM (image-level, not setup.xml) --------------------------------------
# Use MAX_RAM_PERCENTAGE with a container memory limit, or MEMORY for a fixed
# heap. Setting both makes the percentage win.
ERDDAP_MEMORY=4G
# ERDDAP_MAX_RAM_PERCENTAGE=75

# UID/GID the container writes erddap/data as. Match the host user that owns
# the bind mount, or the gate will not be able to write reload flags.
TOMCAT_USER_ID=1000
TOMCAT_GROUP_ID=1000
