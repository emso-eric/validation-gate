{
  "uid": "emso-federation-overview",
  "title": "EMSO Federation Overview",
  "description": "Federation health from the validation gate. Every panel reads the ${datasource} variable, so the database can be repointed from the dropdown above.",
  "tags": ["emso", "federation", "gate"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "description": "Which gate database these panels read.",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "facility",
        "label": "Facility",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "${datasource}" },
        "definition": "SELECT DISTINCT facility FROM v_dataset_current ORDER BY 1",
        "query": "SELECT DISTINCT facility FROM v_dataset_current ORDER BY 1",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Declared",
      "description": "Datasets git currently declares.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT declared FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy",
      "description": "Passed every enforced rule, and therefore federated.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT healthy FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocked",
      "description": "Reachable and scored, but failed at least one rule. The facility's metadata to fix.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT blocked FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unreachable",
      "description": "HTTP error or timeout. A regional ERDDAP to fix, not metadata.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT unreachable FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unhandled",
      "description": "The compliance engine itself broke. A gate bug, not a facility problem.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT unhandled FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Mean required score",
      "description": "Average of the REQUIRED-attribute percentage across every scored dataset.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT mean_required_score FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Declared vs federated over time",
      "description": "One point per completed run, so a flat federation is a flat line rather than a gap.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "declared" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          },
          {
            "matcher": { "id": "byName", "options": "federated" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "blocked" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unreachable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unhandled" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "pending" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", declared, federated, blocked, unreachable, unhandled, pending FROM v_federation_timeline WHERE $__timeFilter(time) ORDER BY time;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Current status mix",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "healthy" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "blocked" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unreachable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unhandled" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "pending" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT healthy, blocked, unreachable, unhandled, pending FROM v_federation_summary;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Per-facility health",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": true, "reducer": ["sum"], "countRows": false, "fields": ["declared", "healthy", "blocked", "unreachable", "unhandled", "pending"] }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "healthy" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "blocked" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "red", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "unreachable" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "orange", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "unhandled" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "yellow", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "mean_required_score" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 70 }, { "color": "green", "value": 90 }] } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT facility, declared, healthy, blocked, unreachable, unhandled, pending, mean_required_score, oldest_check FROM v_facility_summary WHERE facility = ANY (ARRAY[${facility:sqlstring}]) ORDER BY facility;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Needs attention",
      "description": "Everything not federated, worst first. Datasets that were never scored sort last: they need an ERDDAP fixed, not metadata.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "points_short", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "blocked": { "color": "red", "index": 0, "text": "blocked" } } },
                  { "type": "value", "options": { "unreachable": { "color": "orange", "index": 1, "text": "unreachable" } } },
                  { "type": "value", "options": { "unhandled": { "color": "yellow", "index": 2, "text": "unhandled" } } },
                  { "type": "value", "options": { "pending": { "color": "blue", "index": 3, "text": "pending" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "required_score" },
            "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "threshold" },
            "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }]
          },
          {
            "matcher": { "id": "byName", "options": "detail" },
            "properties": [{ "id": "custom.width", "value": 520 }]
          },
          {
            "matcher": { "id": "byName", "options": "dataset_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Score history for this dataset",
                    "url": "/d/emso-dataset-history/emso-dataset-history?var-dataset=${__value.raw}&var-datasource=${datasource}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT facility, dataset_id, status, required_score, threshold, points_short, operational_passed, keywords_passed, detail, last_checked_at FROM v_attention WHERE facility = ANY (ARRAY[${facility:sqlstring}]);",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 40,
      "type": "table",
      "title": "Regressed since last healthy",
      "description": "Healthy at some point in the past, not healthy now. This is what the old 'degraded' status used to be: derived from history rather than stored.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 35 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "required_score" },
            "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT facility, dataset_id, current_status, required_score, last_healthy_at, detail FROM v_regressions WHERE facility = ANY (ARRAY[${facility:sqlstring}]);",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 41,
      "type": "table",
      "title": "Facility mismatches",
      "description": "The dataset's own emso_facility disagrees with the federation/ directory it is filed under. Almost always a metadata error.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 35 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT registry_facility, declared_facility, dataset_id, last_checked_at FROM v_facility_mismatch;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 50,
      "type": "table",
      "title": "Recent runs",
      "description": "Which engine and which policy produced each set of verdicts.",
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 44 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duration_s" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "success": { "color": "green", "index": 0, "text": "success" } } },
                  { "type": "value", "options": { "failed": { "color": "red", "index": 1, "text": "failed" } } },
                  { "type": "value", "options": { "aborted": { "color": "purple", "index": 2, "text": "aborted" } } },
                  { "type": "value", "options": { "running": { "color": "blue", "index": 3, "text": "running" } } }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run_id, started_at, duration_s, outcome, mode, trigger, datasets_checked, datasets_healthy, datasets_blocked, datasets_unreachable, datasets_unhandled, datasets_federated, federation_blocked, federation_unreachable, specs_version, harmonizer_version, threshold FROM v_runs LIMIT 50;",
          "datasource": { "type": "postgres", "uid": "${datasource}" }
        }
      ]
    }
  ]
}
