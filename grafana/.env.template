# ---------------------------------------------------------------------------
# Grafana, service-specific settings. Copy to grafana/.env.
#
#     cp grafana/.env.template grafana/.env
#
# The admin credentials and the public root URL are NOT here: they are
# deployment configuration and live in the repository-root .env, which compose
# layers underneath this file.
#
# The PostgreSQL datasource is provisioned from
# grafana/provisioning/datasources/ and takes its credentials from the root
# .env via compose, so nothing about the database belongs here either.
# ---------------------------------------------------------------------------

# Dashboards are provisioned read-only from grafana/dashboards/. Editing one
# in the UI and not committing it is how a dashboard silently diverges from
# the repository.
GF_USERS_DEFAULT_THEME=light
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# Set alongside GF_SERVER_ROOT_URL in the root .env when Grafana is served
# under a sub-path rather than at the root of its hostname.
# GF_SERVER_SERVE_FROM_SUB_PATH=true
