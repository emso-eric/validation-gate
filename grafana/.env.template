# ---------------------------------------------------------------------------
# Grafana. Copy to grafana/.env and fill in.
#
#     cp grafana/.env.template grafana/.env
#
# The datasource itself is provisioned from grafana/provisioning/datasources/
# and takes its credentials from the repository-root .env via compose, so
# nothing about PostgreSQL belongs here.
# ---------------------------------------------------------------------------

# The initial admin login. Grafana stores the password in its own database on
# first start, so changing it here later has no effect - change it in the UI,
# or delete grafana/data to re-provision from scratch.
#
# Generate a password with:  openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Dashboards are provisioned read-only from grafana/dashboards/. Editing one
# in the UI and not committing it is how a dashboard silently diverges from
# the repository, so saving is disabled.
GF_USERS_DEFAULT_THEME=light
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# Set when Grafana is served under a path or a public hostname.
# GF_SERVER_ROOT_URL=https://monitoring.example.org/grafana
# GF_SERVER_SERVE_FROM_SUB_PATH=true
