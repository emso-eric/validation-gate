# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
*/.env
!*.env.template

# Backups written by `gate.py password-rotate`, and its temporary file. These
# hold the PREVIOUS passwords, so they are exactly as secret as .env itself.
*.env.bckp.*
.env.bckp.*
*.env.tmp
.env.tmp

# ---------------------------------------------------------------------------
# Build artefacts
#
# datasets.xml is generated by the gate from federation/ and the database.
# It is deliberately NOT committed: committing it invites hand edits, and a
# hand edit is silently overwritten by the next run.
# ---------------------------------------------------------------------------
erddap/datasets.xml
erddap/datasets.xml.tmp
erddap/datasets.xml.backups/
erddap/data/

# logo.png and favicon.ico are deliberately NOT ignored: they are committed and
# bind-mounted read-only into the ERDDAP container, so a fresh checkout has
# them and Docker never has to invent them.

# The compliance engine's downloaded specifications and vocabularies (~115 MB).
# Keep the directory itself on persistent storage: a cold cache costs a few
# seconds per run, every run.
cache/

# CSV dumps from `gate.py list --out`.
*.csv

# Gate run logs (rotated daily, 30-day retention)
logs/

# Database and Grafana state
database/pgdata/
grafana/data/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store