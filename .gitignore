# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
*/.env
!*.env.template

# Backups written by `gate.py password-rotate`, and its temporary file. These
# hold the PREVIOUS passwords, so they are exactly as secret as .env itself.
*.env.bckp.*
.env.bckp.*
*.env.tmp
.env.tmp

# Personal information: real names and GitHub usernames. Commit
# access.yaml.template instead.
.github/access/access.yaml

# ---------------------------------------------------------------------------
# Build artefacts
#
# datasets.xml is generated by the gate from federation/ and the database.
# It is deliberately NOT committed: committing it invites hand edits, and a
# hand edit is silently overwritten by the next run.
# ---------------------------------------------------------------------------
erddap/datasets.xml
erddap/datasets.xml.tmp
erddap/datasets.xml.backups/
erddap/data/
erddap/logo.png
erddap/favicon.ico

# The compliance engine's downloaded specifications and vocabularies (~115 MB)
# and its temporary .nc downloads.
gate/cache/

# Compliance reports. The authoritative copy of every one of these is in
# PostgreSQL; the files are the convenient copy.
gate/reports/

# Gate run logs (rotated daily, 30-day retention)
logs/

# Database and Grafana state
database/pgdata/
grafana/data/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store


*.csv
cache/*