# ---------------------------------------------------------------------------
# Global deployment configuration. Copy to .env and fill in.
#
#     cp .env.template .env
#
# THIS is the file you edit when you deploy the central node on a new server:
# every address, port, host and password for every service lives here, in one
# place. Docker Compose reads it twice - once for ${VAR} interpolation in
# docker-compose.yaml, and once as an env_file for every service - and the gate
# reads it directly to build its database connection string.
#
# Service-specific tuning that does NOT change between deployments lives next
# to each service instead, and is layered on top of this file:
#
#     database/.env   initdb options
#     erddap/.env     identity, contact details, caching, threads, display
#     grafana/.env    theme, analytics
#
# Where the same variable appears in both, the service file wins.
#
# .env is gitignored; this template is committed. Nothing secret belongs in a
# template. Generate every password below with:
#
#     openssl rand -base64 24
#
# or rotate all of them at once, on the live services, with:
#
#     ./gate.py password-rotate
# ---------------------------------------------------------------------------

# --- published ports -------------------------------------------------------
# host:container. The database is bound to loopback by default; widen it only
# if Grafana or psql run outside this compose project.
ERDDAP_PORT=8080
GRAFANA_PORT=3000
GATE_DB_PORT=127.0.0.1:5432

# --- host user -------------------------------------------------------------
# Everything the gate and ERDDAP write lands in the bind-mounted working tree,
# and a root-owned artefact there is what stops ./gate.py working on the host
# afterwards. Must own the checkout.
#
#     id -u   ->  UID
#     id -g   ->  GID
UID=1000
GID=1000

# --- database --------------------------------------------------------------
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB configure the postgres
# container itself. POSTGRES_HOST and POSTGRES_PORT are ignored by that image
# and tell the gate where to reach it, so they are the *published* address from
# GATE_DB_PORT above, not the compose service name - the gate normally runs on
# the host. The gate container is handed GATE_DATABASE_URL instead.
#
# The gate builds its connection string from exactly these five:
#
#     postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB
POSTGRES_USER=gate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=emso_gate
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- grafana ---------------------------------------------------------------
# The initial admin login. Grafana stores the password in its own database on
# first start, so editing this afterwards has no effect on a running instance -
# `./gate.py password-rotate` applies it with grafana-cli.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Set when Grafana is served under a public hostname or a sub-path.
# GF_SERVER_ROOT_URL=https://monitoring.example.org/grafana

# --- erddap ----------------------------------------------------------------
# The public base URLs, without a trailing slash. ERDDAP writes these into
# every link, every .iso19115 record and every DAP response, so getting them
# wrong is visible to harvesters long after it is fixed here.
ERDDAP_baseUrl=http://localhost:8080
ERDDAP_baseHttpsUrl=https://localhost:8443

# Where ERDDAP sends its failure reports from. A malformed datasets.xml, a
# dataset that will not load and an unreachable regional server are all
# reported by mail and nowhere else. Leave the host blank to disable mail.
# The recipients are in erddap/.env, with the rest of the contact details.
ERDDAP_emailSmtpHost=
ERDDAP_emailSmtpPort=25
ERDDAP_emailUserName=
ERDDAP_emailPassword=

# Signs the flag URLs the gate uses to reload a single dataset. Generated
# randomly by the image when empty, but then it changes on every recreate and
# every previously issued flag URL stops working. Set it once.
ERDDAP_flagKeyKey=
