# ---------------------------------------------------------------------------
# Docker Compose interpolation. Copy to .env and fill in.
#
#     cp .env.template .env
#
# Only docker-compose.yaml reads this file. Each service keeps its own
# environment in its own directory, with a template next to it:
#
#     database/.env.template  ->  database/.env
#     erddap/.env.template    ->  erddap/.env
#     grafana/.env.template   ->  grafana/.env
#
# Every .env is gitignored; every .env.template is committed. Nothing secret
# belongs in a template.
# ---------------------------------------------------------------------------

# --- database credentials --------------------------------------------------
# These must match database/.env exactly. Compose interpolates them into the
# gate's GATE_DATABASE_URL and into Grafana's provisioned datasource, so a
# mismatch surfaces as an authentication failure in two places at once.
#
# Generate a password with:  openssl rand -base64 24
POSTGRES_USER=gate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=emso_gate

# --- published ports -------------------------------------------------------
# The database is bound to loopback by default; widen it only if Grafana or
# psql run outside this compose project.
ERDDAP_PORT=8080
GRAFANA_PORT=3000
GATE_DB_PORT=127.0.0.1:5432

# --- host user for the gate container --------------------------------------
# The gate writes erddap/datasets.xml and the reload flags as this user, so it
# must own those bind mounts or ./gate.py cannot write them on the host
# afterwards. Compose defaults to 1000:1000 when these are unset; uncomment
# and set them to your own ids if that is wrong.
#
#     id -u   ->  UID
#     id -g   ->  GID
# UID=1000
# GID=1000
